# Copy to backend/.env for development. Real environment variables take precedence over this file.
# Production (config.settings.prod) never reads this file: see docs/deployment.md for its variables.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (the supported database)
POSTGRES_DB=loomdesk
POSTGRES_USER=loomdesk
POSTGRES_PASSWORD=loomdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to "sqlite" only for a quick local check when PostgreSQL is not installed.
# DB_ENGINE=sqlite

# Password given to every seeded demo account by `manage.py seed_demo`.
SEED_DEMO_PASSWORD=loomdesk-demo
